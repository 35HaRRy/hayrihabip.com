{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\API\\API.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "WebSite: build SSR",
      "type": "npm",
      "script": "build:ssr",
      "path": "WebSite",
      "problemMatcher": []
    },
    {
      "label": "WebSite: typecheck",
      "type": "npm",
      "script": "typecheck",
      "path": "WebSite",
      "problemMatcher": "$tsc"
    }
  ]
}

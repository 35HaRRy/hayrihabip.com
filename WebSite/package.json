{
  "name": "hayrihabip.com",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "overrides": {
    "@vercel/static-config": {
      "ajv": "^8.18.0"
    }
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 4000",
    "dev:ssr": "npm run dev",
    "build": "react-router build",
    "build:ssr": "npm run build",
    "serve:ssr": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.cjs build/server/index.js",
    "preview": "npm run serve:ssr",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:unit": "node --import ./tests/register-css.mjs --import tsx --test tests/api.test.ts tests/render.test.tsx",
    "test:ssr": "node --test tests/ssr.test.mjs",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@react-router/dev": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/react-router": "^1.3.7",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "isbot": "^5.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^7.3.7"
  }
}
